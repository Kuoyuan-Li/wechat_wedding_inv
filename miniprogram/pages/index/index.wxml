<view wx:if="{{!assetsReady}}" class="loading-screen">
  <view class="loading-panel">
    <text class="loading-title">正在准备邀请函</text>
    <view class="loading-spinner"></view>
  </view>
</view>

<view wx:if="{{imageUrlsReady && !assetsReady}}" class="image-preloader" aria-hidden="true">
  <block wx:for="{{preloadImages}}" wx:key="id">
    <image
      class="image-preloader-item"
      src="{{item.src}}"
      data-key="{{item.id}}"
      data-src="{{item.src}}"
      mode="widthFix"
      bindload="onPreloadImageComplete"
      binderror="onPreloadImageComplete"
    ></image>
  </block>
</view>

<swiper
  wx:if="{{assetsReady}}"
  class="invitation-swiper"
  vertical="{{true}}"
  duration="{{520}}"
  current="{{currentSection}}"
  disable-touch="{{sectionSwipeDisabled}}"
  bindchange="onSectionChange"
>
  <swiper-item>
    <view class="screen cover-screen">
      <scroll-view
        class="cover-scroll"
        scroll-y="{{true}}"
        enhanced="{{true}}"
        show-scrollbar="{{false}}"
        bindscroll="onCoverScroll"
        bindscrolltolower="onCoverScrollToLower"
        bindtouchstart="onCoverTouchStart"
        bindtouchend="onCoverTouchEnd"
      >
        <view class="cover-content">
          <view class="cover-top-space"></view>
          <image class="cover-image" src="{{coverImage}}" data-src="{{coverImage}}" mode="widthFix" bindload="onCoverImageLoad" binderror="onCloudImageError"></image>
        </view>
      </scroll-view>
      </view>
  </swiper-item>

  <swiper-item>
    <view class="screen prelude-screen">
      <image class="screen-decoration screen-decoration--top-right" src="/assets/decoration1_transparent.png" mode="widthFix"></image>
      <image class="screen-decoration screen-decoration--bottom-left" src="/assets/decoration2_transparent.png" mode="widthFix"></image>
      <view class="screen-inner prelude-inner">
        <view class="section-top-space"></view>
        <view class="prelude-content">
          <view class="section-heading memory-heading prelude-heading">
            <text class="section-title prelude-title">婚礼之前，</text>
            <text class="section-title prelude-title">我们想让你知道...</text>
          </view>
        </view>
      </view>

      <view class="next-cue">
        <text class="next-title">我们的八年</text>
        <text class="next-arrow">⌄</text>
      </view>
    </view>
  </swiper-item>

  <swiper-item>
    <view class="screen memory-screen">
      <image class="screen-decoration screen-decoration--top-right" src="/assets/decoration1_transparent.png" mode="widthFix"></image>
      <image class="screen-decoration screen-decoration--bottom-left" src="/assets/decoration2_transparent.png" mode="widthFix"></image>
      <view class="screen-inner memory-inner">
        <view class="section-top-space"></view>
        <view class="section-heading memory-heading">
          <text class="section-title">我们的八年</text>
        </view>

        <swiper
          class="memory-carousel"
          current="{{currentMemory}}"
          duration="{{420}}"
          circular="{{true}}"
          easing-function="easeInOutCubic"
          bindchange="onMemoryChange"
        >
          <block wx:for="{{memories}}" wx:key="id">
            <swiper-item class="memory-slide">
              <view class="memory-card">
                <view class="memory-image-frame">
                  <image class="memory-image" src="{{item.image}}" data-src="{{item.image}}" mode="aspectFit" binderror="onCloudImageError"></image>
                </view>
                <view class="memory-copy">
                  <text class="memory-title">{{item.title}}</text>
                  <text class="memory-text">{{item.text}}</text>
                </view>
              </view>
            </swiper-item>
          </block>
        </swiper>

        <view class="memory-progress">
          <block wx:for="{{memoryDots}}" wx:key="id">
            <view class="progress-dot {{item.active ? 'progress-dot--active' : ''}}"></view>
          </block>
        </view>
      </view>

      <view class="next-cue">
        <text class="next-title">婚礼详情</text>
        <text class="next-arrow">⌄</text>
      </view>
    </view>
  </swiper-item>

  <swiper-item>
    <view class="screen detail-screen">
      <image class="screen-decoration screen-decoration--top-right" src="/assets/decoration1_transparent.png" mode="widthFix"></image>
      <image class="screen-decoration screen-decoration--bottom-left" src="/assets/decoration2_transparent.png" mode="widthFix"></image>
      <view class="detail-top-space"></view>
      <view class="detail-poster-shell">
        <image class="detail-poster" src="/assets/wedding_info_2.0.png" mode="widthFix"></image>
        <button class="map-button detail-map-button" hover-class="map-button--hover" bindtap="openMap">
          <view class="map-icon">
            <view class="map-icon-dot"></view>
          </view>
          <text>导航</text>
        </button>
      </view>

      <view class="next-cue">
        <text class="next-title">等你来</text>
        <text class="next-arrow">⌄</text>
      </view>
    </view>
  </swiper-item>

  <swiper-item>
    <view class="screen guest-screen">
      <image class="screen-decoration screen-decoration--top-right" src="/assets/decoration1_transparent.png" mode="widthFix"></image>
      <image class="screen-decoration screen-decoration--bottom-left" src="/assets/decoration2_transparent.png" mode="widthFix"></image>
      <view class="screen-inner guest-inner">
        <view class="section-top-space"></view>
        <view class="section-heading">
          <text class="section-title">等你来</text>
        </view>

        <view class="form-panel">
          <view class="field-group">
            <text class="field-label">姓名</text>
            <input
              class="field-input"
              value="{{guestName}}"
              placeholder="请输入您的姓名"
              placeholder-class="field-placeholder"
              maxlength="18"
              bindinput="onGuestNameInput"
            />
          </view>

          <view class="field-group">
            <text class="field-label">宾客数量</text>
            <picker
              class="guest-picker"
              mode="selector"
              range="{{guestCountOptions}}"
              value="{{guestCountIndex}}"
              bindchange="onGuestCountChange"
            >
              <view class="picker-display {{guestCountIndex === 0 ? 'picker-display--placeholder' : ''}}">
                <text>{{selectedGuestCount}}</text>
                <text class="picker-arrow">⌄</text>
              </view>
            </picker>
          </view>

          <button
            class="submit-button"
            hover-class="submit-button--hover"
            disabled="{{submitting}}"
            loading="{{submitting}}"
            bindtap="submitGuestInfo"
          >
            {{submitting ? '提交中...' : '提交信息'}}
          </button>
        </view>

      </view>
    </view>
  </swiper-item>
</swiper>

<view wx:if="{{showLetterModal}}" class="letter-mask" bindtap="closeLetterModal">
  <view class="letter-scene letter-stage--{{letterStage}}" catchtap="noop">
    <view wx:if="{{letterStage !== 'open'}}" class="envelope-wrap">
      <view class="envelope">
        <view class="envelope-back"></view>
        <view class="envelope-flap"></view>
        <view class="envelope-front envelope-front--left"></view>
        <view class="envelope-front envelope-front--right"></view>
        <view class="envelope-front envelope-front--bottom"></view>
        <view class="envelope-seal"></view>
      </view>
    </view>

    <view wx:if="{{letterStage === 'open'}}" class="letter-paper">
      <text class="letter-title">给你的一封信</text>
      <text class="letter-body">{{activeLetter.text}}</text>
      <block wx:if="{{activeLetter.images.length}}">
        <block wx:for="{{activeLetter.images}}" wx:key="*this">
          <image class="letter-image" src="{{item}}" mode="widthFix"></image>
        </block>
      </block>
      <button class="letter-button" hover-class="letter-button--hover" bindtap="closeLetterModal">
        收下这封信
      </button>
    </view>
  </view>
</view>
