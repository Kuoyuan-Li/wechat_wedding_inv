<view wx:if="{{!assetsReady}}" class="loading-screen">
  <view class="loading-panel">
    <text class="loading-title">正在准备邀请函</text>
    <view class="loading-spinner"></view>
  </view>
</view>

<view wx:if="{{imageUrlsReady && !assetsReady}}" class="image-preloader" aria-hidden="true">
  <block wx:for="{{preloadImages}}" wx:key="id">
    <image
      class="image-preloader-item"
      src="{{item.src}}"
      data-key="{{item.id}}"
      data-src="{{item.src}}"
      mode="widthFix"
      bindload="onPreloadImageLoad"
      binderror="onPreloadImageError"
    ></image>
  </block>
</view>

<view
  wx:if="{{assetsReady}}"
  class="music-toggle {{isMusicPlaying && !musicMuted ? 'music-toggle--playing' : ''}} {{musicMuted ? 'music-toggle--muted' : ''}}"
  hover-class="music-toggle--hover"
  aria-label="{{musicMuted ? '打开背景音乐' : '关闭背景音乐'}}"
  bindtap="toggleBackgroundMusic"
>
  <view class="music-disc">
    <text class="music-note">♪</text>
  </view>
</view>

<swiper
  wx:if="{{assetsReady}}"
  class="invitation-swiper"
  vertical="{{true}}"
  duration="{{760}}"
  current="{{currentSection}}"
  disable-touch="{{sectionSwipeDisabled}}"
  easing-function="easeInOutCubic"
  bindtransition="onSectionTransition"
  bindchange="onSectionChange"
>
  <swiper-item>
    <view class="screen cover-screen cover-motion">
      <scroll-view
        class="cover-scroll"
        scroll-y="{{true}}"
        enhanced="{{true}}"
        show-scrollbar="{{false}}"
        bindscroll="onCoverScroll"
        bindscrolltolower="onCoverScrollToLower"
        bindtouchstart="onCoverTouchStart"
        bindtouchend="onCoverTouchEnd"
      >
        <view class="cover-content">
          <view class="cover-top-space"></view>
          <image class="cover-image" src="{{coverImage}}" data-src="{{coverImage}}" mode="widthFix" bindload="onCoverImageLoad" binderror="onCloudImageError"></image>
        </view>
      </scroll-view>
      </view>
  </swiper-item>

  <swiper-item>
    <view class="screen wedding-photo-screen section-motion section-motion--{{sectionDirection}} {{currentSection === 1 || previewSection === 1 ? 'section-motion--active' : ''}} {{previousSection === 1 && sectionTransitioning ? 'section-motion--exit' : ''}}">
      <image class="screen-decoration screen-decoration--top-right" src="/assets/decoration1_transparent.png" mode="widthFix"></image>
      <image class="screen-decoration screen-decoration--bottom-left" src="/assets/decoration2_transparent.png" mode="widthFix"></image>
      <view class="screen-inner wedding-photo-inner">
        <view class="wedding-photo-heading">
          <view class="wedding-photo-title">
            <image class="wedding-photo-title-image" src="/assets/womenjiehunla.svg" mode="widthFix"></image>
          </view>
        </view>

        <swiper
          class="wedding-photo-carousel"
          current="{{currentWeddingPhoto}}"
          duration="{{460}}"
          circular="{{true}}"
          autoplay="{{true}}"
          interval="{{5000}}"
          easing-function="easeInOutCubic"
          bindchange="onWeddingPhotoChange"
        >
          <block wx:for="{{weddingPhotos}}" wx:key="id">
            <swiper-item class="wedding-photo-slide {{index === currentWeddingPhoto ? 'wedding-photo-slide--active' : ''}}">
              <view class="wedding-photo-frame">
                <image class="wedding-photo-image" src="{{item.image}}" data-src="{{item.image}}" mode="widthFix" bindtap="previewWeddingPhoto" binderror="onCloudImageError"></image>
              </view>
            </swiper-item>
          </block>
        </swiper>

        <view class="memory-progress wedding-photo-progress">
          <block wx:for="{{weddingPhotoDots}}" wx:key="id">
            <view class="progress-dot {{item.active ? 'progress-dot--active' : ''}}"></view>
          </block>
        </view>

      </view>

      <view class="next-cue section-cue-motion">
        <text class="next-title">婚礼之前</text>
        <text class="next-arrow">⌄</text>
      </view>
    </view>
  </swiper-item>

  <swiper-item>
    <view class="screen prelude-screen section-motion section-motion--{{sectionDirection}} {{currentSection === 2 || previewSection === 2 ? 'section-motion--active' : ''}} {{previousSection === 2 && sectionTransitioning ? 'section-motion--exit' : ''}}">
      <image class="screen-decoration screen-decoration--top-right" src="/assets/decoration1_transparent.png" mode="widthFix"></image>
      <image class="screen-decoration screen-decoration--bottom-left" src="/assets/decoration2_transparent.png" mode="widthFix"></image>
      <view class="screen-inner prelude-inner">
        <view class="section-top-space"></view>
        <view class="prelude-content">
          <view class="section-heading memory-heading prelude-heading">
            <text class="section-title prelude-title">婚礼之前，</text>
            <text class="section-title prelude-title">我们想让你知道...</text>
          </view>
        </view>
      </view>

      <view class="next-cue section-cue-motion">
        <text class="next-title">我们的八年</text>
        <text class="next-arrow">⌄</text>
      </view>
    </view>
  </swiper-item>

  <swiper-item>
    <view class="screen memory-screen section-motion section-motion--{{sectionDirection}} {{currentSection === 3 || previewSection === 3 ? 'section-motion--active' : ''}} {{previousSection === 3 && sectionTransitioning ? 'section-motion--exit' : ''}}">
      <image class="screen-decoration screen-decoration--top-right" src="/assets/decoration1_transparent.png" mode="widthFix"></image>
      <image class="screen-decoration screen-decoration--bottom-left" src="/assets/decoration2_transparent.png" mode="widthFix"></image>
      <view class="screen-inner memory-inner">
        <view class="section-top-space"></view>
        <view class="section-heading memory-heading">
          <text class="section-title">我们的八年</text>
        </view>

        <swiper
          class="memory-carousel"
          current="{{currentMemory}}"
          duration="{{420}}"
          circular="{{true}}"
          autoplay="{{false}}"
          easing-function="easeInOutCubic"
          bindchange="onMemoryChange"
        >
          <block wx:for="{{memories}}" wx:key="id">
            <swiper-item class="memory-slide {{index === currentMemory ? 'memory-slide--active' : ''}}">
              <view class="memory-card">
                <view class="memory-image-frame">
                  <image class="memory-image" src="{{item.image}}" data-src="{{item.image}}" mode="aspectFit" binderror="onCloudImageError"></image>
                </view>
                <view class="memory-copy">
                  <text class="memory-title">{{item.title}}</text>
                  <text class="memory-text">{{item.text}}</text>
                </view>
              </view>
            </swiper-item>
          </block>
        </swiper>

        <view class="memory-progress">
          <block wx:for="{{memoryDots}}" wx:key="id">
            <view class="progress-dot {{item.active ? 'progress-dot--active' : ''}}"></view>
          </block>
        </view>
      </view>

      <view class="next-cue section-cue-motion">
        <text class="next-title">婚礼详情</text>
        <text class="next-arrow">⌄</text>
      </view>
    </view>
  </swiper-item>

  <swiper-item>
    <view class="screen detail-screen section-motion section-motion--{{sectionDirection}} {{currentSection === 4 || previewSection === 4 ? 'section-motion--active' : ''}} {{previousSection === 4 && sectionTransitioning ? 'section-motion--exit' : ''}}">
      <image class="screen-decoration screen-decoration--top-right" src="/assets/decoration1_transparent.png" mode="widthFix"></image>
      <image class="screen-decoration screen-decoration--bottom-left" src="/assets/decoration2_transparent.png" mode="widthFix"></image>
      <scroll-view
        class="detail-scroll"
        scroll-y="{{true}}"
        enhanced="{{true}}"
        show-scrollbar="{{false}}"
        bindscroll="onDetailScroll"
        bindscrolltolower="onDetailScrollToLower"
        bindtouchstart="onDetailTouchStart"
        bindtouchend="onDetailTouchEnd"
      >
        <view class="detail-content">
          <view class="detail-top-space"></view>
          <view class="detail-poster-shell">
            <image class="detail-poster detail-fade-motion" src="/assets/wedding_info_2.0.png" mode="widthFix" bindload="onDetailImageLoad"></image>
            <button class="map-button detail-map-button detail-fade-motion" hover-class="map-button--hover" bindtap="openMap">
              <view class="map-icon">
                <view class="map-icon-dot"></view>
              </view>
              <text>导航</text>
            </button>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{detailAtBottom}}" class="next-cue section-cue-motion">
        <text class="next-title">等你来</text>
        <text class="next-arrow">⌄</text>
      </view>
    </view>
  </swiper-item>

  <swiper-item>
    <view class="screen guest-screen section-motion section-motion--{{sectionDirection}} {{currentSection === 5 || previewSection === 5 ? 'section-motion--active' : ''}} {{previousSection === 5 && sectionTransitioning ? 'section-motion--exit' : ''}}">
      <image class="screen-decoration screen-decoration--top-right" src="/assets/decoration1_transparent.png" mode="widthFix"></image>
      <image class="screen-decoration screen-decoration--bottom-left" src="/assets/decoration2_transparent.png" mode="widthFix"></image>
      <view class="screen-inner guest-inner">
        <view class="section-top-space"></view>
        <view class="section-heading guest-heading-motion">
          <text class="section-title">等你来</text>
        </view>

        <view class="form-panel guest-form-motion">
          <view class="field-group">
            <text class="field-label">姓名</text>
            <input
              class="field-input"
              value="{{guestName}}"
              placeholder="请输入您的姓名"
              placeholder-class="field-placeholder"
              maxlength="18"
              bindinput="onGuestNameInput"
            />
          </view>

          <view class="field-group">
            <text class="field-label">宾客数量</text>
            <picker
              class="guest-picker"
              mode="selector"
              range="{{guestCountOptions}}"
              value="{{guestCountIndex}}"
              bindchange="onGuestCountChange"
            >
              <view class="picker-display {{guestCountIndex === 0 ? 'picker-display--placeholder' : ''}}">
                <text>{{selectedGuestCount}}</text>
                <text class="picker-arrow">⌄</text>
              </view>
            </picker>
          </view>

          <button
            class="submit-button"
            hover-class="submit-button--hover"
            disabled="{{submitting}}"
            loading="{{submitting}}"
            bindtap="submitGuestInfo"
          >
            {{submitting ? '提交中...' : '提交信息'}}
          </button>
        </view>

      </view>
    </view>
  </swiper-item>
</swiper>

<view wx:if="{{showLetterModal}}" class="letter-mask" bindtap="closeLetterModal">
  <view class="letter-scene letter-stage--{{letterStage}}" catchtap="noop">
    <view wx:if="{{letterStage !== 'open'}}" class="envelope-wrap">
      <view class="envelope">
        <view class="envelope-back"></view>
        <view class="envelope-flap"></view>
        <view class="envelope-front envelope-front--left"></view>
        <view class="envelope-front envelope-front--right"></view>
        <view class="envelope-front envelope-front--bottom"></view>
        <view class="envelope-seal"></view>
      </view>
    </view>

    <view wx:if="{{letterStage === 'open'}}" class="letter-paper">
      <text class="letter-title">给你的一封信</text>
      <text class="letter-body">{{activeLetter.text}}</text>
      <block wx:if="{{activeLetter.images.length}}">
        <block wx:for="{{activeLetter.images}}" wx:key="*this">
          <image class="letter-image" src="{{item}}" mode="widthFix"></image>
        </block>
      </block>
      <button class="letter-button" hover-class="letter-button--hover" bindtap="closeLetterModal">
        收下这封信
      </button>
    </view>
  </view>
</view>
