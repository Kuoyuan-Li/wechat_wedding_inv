page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
  color: #3e302d;
  font-family: "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  line-height: 1;
  font: inherit;
  color: inherit;
}

button::after {
  border: 0;
}

.invitation-swiper,
.screen {
  width: 100%;
  height: 100vh;
}

.loading-screen {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100vh;
  padding: 64rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.loading-panel {
  width: 100%;
  max-width: 520rpx;
  text-align: center;
}

.loading-title {
  display: block;
  color: #6f4d45;
  font-family: "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 34rpx;
  font-weight: normal;
  line-height: 1.35;
}

.loading-spinner {
  width: 54rpx;
  height: 54rpx;
  margin: 34rpx auto 0;
  border: 5rpx solid rgba(111, 77, 69, 0.18);
  border-top-color: #8c1f20;
  border-radius: 50%;
  animation: loading-spin 820ms linear infinite;
}

@keyframes loading-spin {
  to {
    transform: rotate(360deg);
  }
}

.image-preloader {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}

.image-preloader-item {
  width: 1px;
  height: 1px;
}

.music-toggle {
  position: fixed;
  left: 50rpx;
  top: calc(50rpx + env(safe-area-inset-top));
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 0;
  overflow: visible;
  box-sizing: border-box;
  transform-origin: center;
  transition: opacity 240ms ease, transform 240ms ease;
}

.music-disc {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  border: 1rpx solid rgba(140, 31, 32, 0.18);
  border-radius: 999rpx;
  background:
    radial-gradient(circle at center, rgba(255, 255, 255, 0.96) 0 18%, rgba(140, 31, 32, 0.16) 19% 22%, transparent 23%),
    repeating-radial-gradient(circle at center, rgba(140, 31, 32, 0.12) 0 2rpx, rgba(255, 255, 255, 0.78) 3rpx 8rpx);
  box-shadow: 0 12rpx 30rpx rgba(72, 54, 49, 0.12);
  color: #8c1f20;
  backdrop-filter: blur(10rpx);
  box-sizing: border-box;
  transform-origin: center;
  transition: background 240ms ease;
}

.music-toggle--hover {
  opacity: 0.78;
  transform: scale(0.96);
}

.music-toggle--muted {
  opacity: 0.62;
}

.music-toggle--muted .music-disc::after {
  position: absolute;
  left: 17rpx;
  top: 35rpx;
  width: 38rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #8c1f20;
  content: "";
  transform: rotate(-42deg);
}

.music-note {
  display: block;
  font-size: 38rpx;
  line-height: 1;
  transform-origin: center;
}

.music-toggle--playing .music-disc {
  animation: music-disc-spin 2400ms linear infinite;
}

.music-toggle--playing.music-toggle--muted .music-disc {
  animation: none;
}

@keyframes music-disc-spin {
  to {
    transform: rotate(360deg);
  }
}

.screen {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.screen-decoration {
  position: absolute;
  z-index: 2;
  display: block;
  pointer-events: none;
}

.screen-decoration--top-right {
  top: 10vh;
  right: 0;
  width: 21.5vw;
  max-width: 161rpx;
}

.screen-decoration--bottom-left {
  bottom: 8vh;
  left: 0;
  width: 21vw;
  max-width: 157rpx;
}

.screen-inner {
  position: relative;
  z-index: 1;
  height: 100%;
  box-sizing: border-box;
  padding: 0 44rpx calc(132rpx + env(safe-area-inset-bottom));
}

.cover-scroll {
  width: 100%;
  height: 100%;
}

.cover-content {
  position: relative;
  min-height: 100vh;
  background: #ffffff;
}

.cover-top-space {
  height: 10vh;
  background: #ffffff;
}

.cover-image {
  width: 100%;
  height: auto;
  display: block;
}

.cover-motion .cover-image {
  animation: cover-image-fade-in 2480ms cubic-bezier(0.2, 0.86, 0.24, 1) 500ms both;
}

@keyframes cover-image-fade-in {
  from {
    opacity: 0;
    transform: translateY(22rpx) scale(1.012);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.next-cue {
  position: absolute;
  left: 50%;
  bottom: calc(22rpx + env(safe-area-inset-bottom));
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
  color: rgba(31, 41, 51, 0.76);
  text-align: center;
}

.next-cue--cover {
  color: rgba(31, 41, 51, 0.68);
  text-shadow: none;
}

.next-title {
  font-size: 22rpx;
  line-height: 1.3;
  letter-spacing: 0;
}

.next-arrow {
  margin-top: 4rpx;
  font-size: 34rpx;
  line-height: 1;
}

.section-motion .screen-decoration--top-right,
.section-motion .screen-decoration--bottom-left,
.section-motion .wedding-photo-title-image,
.section-motion .wedding-photo-carousel,
.section-motion .wedding-photo-progress,
.section-motion .prelude-title,
.section-motion .memory-heading,
.section-motion .memory-carousel,
.section-motion .memory-progress,
.section-motion .detail-fade-motion,
.section-motion .guest-heading-motion,
.section-motion .guest-form-motion,
.section-motion .section-cue-motion {
  opacity: 0;
  will-change: transform, opacity;
}

.section-motion--active .screen-decoration--top-right {
  animation: section-deco-top-enter 1800ms cubic-bezier(0.2, 0.86, 0.24, 1) 500ms both;
}

.section-motion--active .screen-decoration--bottom-left {
  animation: section-deco-bottom-enter 2000ms cubic-bezier(0.2, 0.86, 0.24, 1) 1200ms both;
}

.section-motion--exit .screen-decoration,
.section-motion--exit .wedding-photo-heading,
.section-motion--exit .wedding-photo-title-image,
.section-motion--exit .wedding-photo-carousel,
.section-motion--exit .wedding-photo-progress,
.section-motion--exit .prelude-content,
.section-motion--exit .prelude-title,
.section-motion--exit .memory-heading,
.section-motion--exit .memory-carousel,
.section-motion--exit .memory-progress,
.section-motion--exit .detail-poster,
.section-motion--exit .guest-heading-motion,
.section-motion--exit .guest-form-motion,
.section-motion--exit .section-cue-motion {
  animation: section-layer-exit 1600ms cubic-bezier(0.2, 0.86, 0.24, 1) both;
}

.section-motion--exit .detail-map-button {
  animation: detail-button-exit 1600ms cubic-bezier(0.2, 0.86, 0.24, 1) both;
}

.section-motion--active .section-cue-motion {
  animation: section-cue-enter 1800ms cubic-bezier(0.2, 0.86, 0.24, 1) 2600ms both, next-cue-breathe 2400ms ease-in-out 4600ms infinite;
}

@keyframes section-deco-top-enter {
  from {
    opacity: 0;
    transform: translateY(22rpx) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translate(0, 0) scale(1);
  }
}

@keyframes section-deco-bottom-enter {
  from {
    opacity: 0;
    transform: translateY(28rpx) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translate(0, 0) scale(1);
  }
}

@keyframes section-layer-exit {
  from {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  to {
    opacity: 0;
    transform: translateY(-42rpx) scale(0.99);
  }
}

@keyframes section-cue-enter {
  from {
    opacity: 0;
    transform: translate(-50%, 18rpx);
  }

  to {
    opacity: 1;
    transform: translate(-50%, 0);
  }
}

@keyframes next-cue-breathe {
  0%,
  100% {
    transform: translate(-50%, 0);
  }

  50% {
    transform: translate(-50%, 8rpx);
  }
}

.memory-screen,
.guest-screen {
  background: #ffffff;
}

.wedding-photo-screen {
  background: linear-gradient(180deg, #ffffff 0%, #ffffff 50%, #fff8f7 76%, #faeeee 100%);
}

.wedding-photo-screen .screen-decoration {
  z-index: 0;
}

.prelude-screen {
  background: #faeeee;
}

.memory-screen {
  background: linear-gradient(180deg, #faeeee 0%, #fff8f7 28%, #ffffff 50%, #ffffff 100%);
}

.prelude-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.prelude-content {
  display: flex;
  flex: 1;
  min-height: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.prelude-heading {
  margin-bottom: 36rpx;
}

.prelude-title {
  display: block;
  margin-top: 0;
}

.prelude-image {
  width: 76%;
  height: auto;
  display: block;
}

.detail-screen {
  background: #ffffff;
}

.guest-screen {
  background: linear-gradient(180deg, #ffffff 0%, #ffffff 50%, #fff8f7 76%, #faeeee 100%);
}

.prelude-screen .section-top-space,
.memory-screen .section-top-space,
.guest-screen .section-top-space {
  background: transparent;
}

.detail-scroll {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.detail-content {
  position: relative;
  min-height: 100vh;
  background: #ffffff;
}

.detail-top-space {
  height: 10vh;
  background: #ffffff;
}

.detail-poster-shell {
  position: relative;
  z-index: 1;
  width: 100%;
  background: #ffffff;
}

.detail-poster {
  width: 100%;
  height: auto;
  display: block;
}

.section-motion--active .detail-poster {
  animation: detail-poster-enter 2200ms cubic-bezier(0.2, 0.86, 0.24, 1) 700ms both;
}

.section-motion--active .detail-map-button {
  animation: detail-button-enter 2000ms cubic-bezier(0.2, 0.86, 0.24, 1) 1500ms both;
}

@keyframes detail-poster-enter {
  from {
    opacity: 0;
    transform: translateY(42rpx) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes detail-button-enter {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(28rpx) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
  }
}

@keyframes detail-button-exit {
  from {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  to {
    opacity: 0;
    transform: translateX(-50%) translateY(-42rpx) scale(0.99);
  }
}

.section-heading {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.section-top-space {
  flex: 0 0 10vh;
  height: 10vh;
  background: #ffffff;
}

.section-kicker {
  color: #766b65;
  font-family: "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 4rpx;
}

.section-title {
  margin-top: 16rpx;
  color: #1f2933;
  font-family: "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 42rpx;
  font-weight: normal;
  line-height: 1.18;
  letter-spacing: 0;
}

/* Match the serif, vermilion typography used for “时间” on the cover. */
.memory-heading .section-title {
  color: #8c1f20;
  font-family: "WeddingSerifBold", "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 60rpx;
  font-weight: normal;
}

.guest-screen .section-title {
  color: #8c1f20;
  font-family: "WeddingSerifBold", "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 60rpx;
  font-weight: normal;
}

.wedding-photo-inner {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: calc(72rpx + env(safe-area-inset-top)) 20rpx calc(118rpx + env(safe-area-inset-bottom));
}

.wedding-photo-inner .section-top-space {
  display: none;
}

.wedding-photo-heading {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  width: 100%;
  text-align: center;
}

.wedding-photo-title {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
}

.wedding-photo-title-line {
  display: block;
  color: #8c1f20;
  font-family: "WeddingSerifBold", "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-weight: normal;
  line-height: 1.15;
  letter-spacing: 0;
  text-shadow: 0 8rpx 18rpx rgba(140, 31, 32, 0.08);
}

.wedding-photo-title-line--primary {
  font-size: 64rpx;
  animation: wedding-title-slide-left 1800ms cubic-bezier(0.2, 0.86, 0.24, 1) 500ms both;
}

.wedding-photo-title-image {
  display: block;
  width: 400rpx;
  height: auto;
}

.wedding-photo-title-line--secondary {
  margin-top: 10rpx;
  font-size: 42rpx;
  animation: wedding-title-slide-right 1800ms cubic-bezier(0.2, 0.86, 0.24, 1) 900ms both;
}

.wedding-photo-carousel {
  flex: 0 0 auto;
  width: 100%;
  height: 68vh;
  max-height: 960rpx;
  min-height: 0;
  margin-top: 18rpx;
}

.wedding-photo-slide {
  box-sizing: border-box;
  padding: 0 6rpx;
}

.wedding-photo-frame {
  display: flex;
  position: relative;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  overflow: visible;
  box-sizing: border-box;
  background: transparent;
}

.wedding-photo-image {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 8rpx;
  box-shadow: 0 12rpx 30rpx rgba(72, 54, 49, 0.12);
}

.wedding-photo-progress {
  height: 42rpx;
  margin-top: 16rpx;
}

.section-motion--active .wedding-photo-title-image {
  animation: wedding-title-slide-left 2000ms cubic-bezier(0.2, 0.86, 0.24, 1) 500ms both;
}

.section-motion--active .wedding-photo-carousel {
  animation: wedding-photo-reveal 2480ms cubic-bezier(0.2, 0.86, 0.24, 1) 1200ms both;
}

.section-motion--active .wedding-photo-progress {
  animation: wedding-photo-progress-enter 1800ms cubic-bezier(0.2, 0.86, 0.24, 1) 3200ms both;
}

.wedding-photo-slide .wedding-photo-image {
  transform: scale(0.985);
  transition: transform 520ms cubic-bezier(0.2, 0.86, 0.24, 1), box-shadow 520ms ease;
}

.wedding-photo-slide--active .wedding-photo-image {
  transform: scale(1);
  box-shadow: 0 18rpx 46rpx rgba(72, 54, 49, 0.18);
}

@keyframes wedding-title-slide-left {
  from {
    opacity: 0;
    transform: translateY(30rpx) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes wedding-title-slide-right {
  from {
    opacity: 0;
    transform: translateY(30rpx) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes wedding-photo-reveal {
  from {
    opacity: 0;
    transform: translateY(46rpx) scale(0.975);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes wedding-photo-progress-enter {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.guest-screen,
.guest-screen button,
.guest-screen input,
.guest-screen .picker-display {
  font-family: "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
}

.memory-inner {
  display: flex;
  flex-direction: column;
}

.memory-screen .screen-decoration {
  z-index: 0;
}

.section-motion--active .prelude-title:first-child {
  animation: prelude-line-enter 2000ms cubic-bezier(0.2, 0.86, 0.24, 1) 600ms both;
}

.section-motion--active .prelude-title:last-child {
  animation: prelude-line-enter 2200ms cubic-bezier(0.2, 0.86, 0.24, 1) 1200ms both;
}

@keyframes prelude-line-enter {
  from {
    opacity: 0;
    transform: translateY(38rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.section-motion--active .memory-heading {
  animation: memory-title-enter 2000ms cubic-bezier(0.2, 0.86, 0.24, 1) 500ms both;
}

.section-motion--active .memory-carousel {
  animation: memory-carousel-enter 2480ms cubic-bezier(0.2, 0.86, 0.24, 1) 1200ms both;
}

.section-motion--active .memory-progress {
  animation: memory-progress-enter 1800ms cubic-bezier(0.2, 0.86, 0.24, 1) 3200ms both;
}

.memory-carousel {
