page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #ffffff;
  color: #3e302d;
  font-family: "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  line-height: 1;
  font: inherit;
  color: inherit;
}

button::after {
  border: 0;
}

.invitation-swiper,
.screen {
  width: 100%;
  height: 100vh;
}

.loading-screen {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100vh;
  padding: 64rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.loading-panel {
  width: 100%;
  max-width: 520rpx;
  text-align: center;
}

.loading-title {
  display: block;
  color: #6f4d45;
  font-family: "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 34rpx;
  font-weight: normal;
  line-height: 1.35;
}

.loading-spinner {
  width: 54rpx;
  height: 54rpx;
  margin: 34rpx auto 0;
  border: 5rpx solid rgba(111, 77, 69, 0.18);
  border-top-color: #8c1f20;
  border-radius: 50%;
  animation: loading-spin 820ms linear infinite;
}

@keyframes loading-spin {
  to {
    transform: rotate(360deg);
  }
}

.image-preloader {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}

.image-preloader-item {
  width: 1px;
  height: 1px;
}

.screen {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.screen-decoration {
  position: absolute;
  z-index: 2;
  display: block;
  pointer-events: none;
}

.screen-decoration--top-right {
  top: 10vh;
  right: 0;
  width: 161rpx;
}

.screen-decoration--bottom-left {
  bottom: calc(100vh - 10vh - 1334rpx);
  left: 0;
  width: 157rpx;
}

.screen-inner {
  position: relative;
  z-index: 1;
  height: 100%;
  box-sizing: border-box;
  padding: 0 44rpx calc(132rpx + env(safe-area-inset-bottom));
}

.cover-scroll {
  width: 100%;
  height: 100%;
}

.cover-content {
  position: relative;
  min-height: 100vh;
  background: #ffffff;
}

.cover-top-space {
  height: 10vh;
  background: #ffffff;
}

.cover-image {
  width: 100%;
  height: auto;
  display: block;
}

.next-cue {
  position: absolute;
  left: 50%;
  bottom: calc(22rpx + env(safe-area-inset-bottom));
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
  color: rgba(31, 41, 51, 0.76);
  text-align: center;
}

.next-cue--cover {
  color: rgba(31, 41, 51, 0.68);
  text-shadow: none;
}

.next-title {
  font-size: 22rpx;
  line-height: 1.3;
  letter-spacing: 0;
}

.next-arrow {
  margin-top: 4rpx;
  font-size: 34rpx;
  line-height: 1;
}

.memory-screen,
.guest-screen {
  background: #ffffff;
}

.prelude-screen {
  background: #ffffff;
}

.prelude-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.prelude-content {
  display: flex;
  flex: 1;
  min-height: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.prelude-heading {
  margin-bottom: 36rpx;
}

.prelude-title {
  display: block;
  margin-top: 0;
}

.prelude-image {
  width: 76%;
  height: auto;
  display: block;
}

.detail-screen {
  background: #ffffff;
}

.detail-top-space {
  height: 10vh;
  background: #ffffff;
}

.detail-poster {
  position: relative;
  z-index: 0;
  width: 100%;
  height: auto;
  display: block;
}

.section-heading {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.section-top-space {
  flex: 0 0 10vh;
  height: 10vh;
  background: #ffffff;
}

.section-kicker {
  color: #766b65;
  font-family: "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 4rpx;
}

.section-title {
  margin-top: 16rpx;
  color: #1f2933;
  font-family: "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 42rpx;
  font-weight: normal;
  line-height: 1.18;
  letter-spacing: 0;
}

/* Match the serif, vermilion typography used for “时间” on the cover. */
.memory-heading .section-title {
  color: #8c1f20;
  font-family: "WeddingSerifBold", "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 60rpx;
  font-weight: normal;
}

.guest-screen .section-title {
  color: #8c1f20;
  font-family: "WeddingSerifBold", "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 60rpx;
  font-weight: normal;
}

.guest-screen,
.guest-screen button,
.guest-screen input,
.guest-screen .picker-display {
  font-family: "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
}

.memory-inner {
  display: flex;
  flex-direction: column;
}

.memory-screen .screen-decoration {
  z-index: 0;
}

.memory-carousel {
  flex: 1;
  width: 100%;
  min-height: 0;
  margin-top: 24rpx;
}

.memory-slide {
  box-sizing: border-box;
  padding: 0 28rpx;
}

.memory-card {
  display: flex;
  height: 100%;
  min-height: 0;
  flex-direction: column;
  justify-content: center;
  padding: 18rpx 18rpx 28rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 22rpx 52rpx rgba(72, 54, 49, 0.16);
}

.memory-image-frame {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 54%;
  min-height: 0;
  max-height: 600rpx;
  overflow: hidden;
  background: #ffffff;
  border: 0;
}

.memory-image {
  width: 100%;
  height: 100%;
  display: block;
}

.memory-copy {
  position: relative;
  margin: 0;
  padding: 26rpx 10rpx 4rpx;
  border-left: 0;
  background: transparent;
  box-shadow: none;
  text-align: center;
}

.memory-title {
  display: block;
  margin-top: 14rpx;
  color: #3e302d;
  font-family: "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 36rpx;
  font-weight: normal;
  line-height: 1.28;
}

.memory-text {
  display: block;
  margin-top: 14rpx;
  color: #6b5954;
  font-family: "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 26rpx;
  line-height: 1.72;
}

.memory-progress {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  height: 52rpx;
  margin-top: 14rpx;
}

.progress-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(121, 88, 79, 0.22);
  transition: width 180ms ease, background 180ms ease;
}

.progress-dot--active {
  width: 30rpx;
  background: #7d5a52;
}

.detail-inner {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
}

.detail-heading {
  margin-bottom: 54rpx;
}

.date-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 48rpx;
  border-bottom: 1rpx solid rgba(126, 96, 87, 0.2);
}

.date-number {
  color: #66423b;
  font-family: "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 104rpx;
  line-height: 0.98;
}

.date-year {
  margin-top: 18rpx;
  color: #7a655f;
  font-size: 26rpx;
  line-height: 1.4;
}

.detail-list {
  margin-top: 46rpx;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(126, 96, 87, 0.14);
}

.detail-label {
  flex: 0 0 118rpx;
  color: #9a7d74;
  font-size: 24rpx;
  line-height: 1.5;
}

.detail-value {
  color: #3e302d;
  font-family: "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 30rpx;
  font-weight: normal;
  line-height: 1.5;
}

.detail-subvalue {
  display: block;
  margin-top: 4rpx;
  color: #6b5954;
  font-size: 26rpx;
  line-height: 1.5;
}

.location-copy {
  flex: 1;
}

.map-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  min-height: 92rpx;
  margin-top: 46rpx;
  border: 1rpx solid rgba(103, 71, 62, 0.22);
  border-radius: 8rpx;
  background: #6f4d45;
  color: #ffffff;
  font-family: "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 28rpx;
  font-weight: normal;
  transition: opacity 160ms ease, transform 160ms ease;
}

.map-button--hover {
  opacity: 0.86;
  transform: scale(0.99);
}

.detail-map-button {
  position: absolute;
  left: 50%;
  top: calc(1162rpx + 10vh);
  z-index: 2;
  min-width: 180rpx;
  min-height: 66rpx;
  margin-top: 0;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  transform: translateX(-50%);
}

.detail-map-button.map-button--hover {
  transform: translateX(-50%) scale(0.99);
}

.map-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.map-icon-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #ffffff;
  transform: translate(-50%, -50%);
}

.guest-inner {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.guest-inner .section-top-space {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
}

.form-panel {
  margin-top: 56rpx;
  padding: 8rpx 0 0;
}

.field-group {
  margin-bottom: 34rpx;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: #6c5751;
  font-size: 25rpx;
  line-height: 1.4;
  text-align: left;
}

.field-input,
.picker-display {
  width: 100%;
  min-height: 92rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(129, 96, 87, 0.2);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #3e302d;
  font-size: 30rpx;
  line-height: 92rpx;
  text-align: left;
}

.field-placeholder {
  color: #b5a29c;
}

.guest-picker {
  display: block;
}

.picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-display--placeholder {
  color: #b5a29c;
}

.picker-arrow {
  color: #a68a81;
  font-size: 32rpx;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  margin-top: 66rpx;
  border-radius: 8rpx;
  background: #6f4d45;
  color: #ffffff;
  font-family: "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 30rpx;
  font-weight: normal;
  transition: opacity 160ms ease, transform 160ms ease;
}

.submit-button--hover {
  opacity: 0.86;
  transform: scale(0.99);
}

.guest-note {
  display: block;
  margin-top: 34rpx;
  color: #8a746d;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
}

.letter-mask {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100vh;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(53, 37, 34, 0.42);
}

.letter-scene {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 78vh;
  max-width: 650rpx;
}

.envelope-wrap {
  position: absolute;
  left: 50%;
  top: 60%;
  width: 600rpx;
  height: 390rpx;
  perspective: 1200rpx;
  transform: translate(-50%, -50%);
}

.envelope {
  position: absolute;
  left: 0;
  bottom: 0;
  z-index: 3;
  width: 100%;
  height: 360rpx;
}

.envelope-back {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 320rpx;
  border-radius: 8rpx;
  background: #ead5ca;
  box-shadow: 0 28rpx 70rpx rgba(49, 30, 26, 0.26);
}

.envelope-flap {
  position: absolute;
  left: 0;
  top: 40rpx;
  z-index: 5;
  width: 0;
  height: 0;
  border-left: 300rpx solid transparent;
  border-right: 300rpx solid transparent;
  border-top: 190rpx solid #d8aa99;
  transform-origin: center top;
  transition: transform 1200ms ease, z-index 1200ms ease;
}

.envelope-front {
  position: absolute;
  bottom: 0;
  width: 0;
  height: 0;
}

.envelope-front--left {
  left: 0;
  z-index: 4;
  border-bottom: 320rpx solid #e4c2b5;
  border-right: 315rpx solid transparent;
}

.envelope-front--right {
  right: 0;
  z-index: 4;
  border-bottom: 320rpx solid #e0baab;
  border-left: 315rpx solid transparent;
}

.envelope-front--bottom {
  left: 0;
  z-index: 6;
  border-left: 300rpx solid transparent;
  border-right: 300rpx solid transparent;
  border-bottom: 210rpx solid #c99180;
}

.envelope-seal {
  position: absolute;
  left: 50%;
  top: 166rpx;
  z-index: 7;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: #8c1f20;
  box-shadow: 0 8rpx 18rpx rgba(92, 30, 27, 0.25);
  transform: translateX(-50%);
  transition: opacity 500ms ease, transform 500ms ease;
}

.letter-paper {
  position: relative;
  z-index: 8;
  width: 510rpx;
  max-height: 62vh;
  padding: 46rpx 38rpx 38rpx;
  box-sizing: border-box;
  overflow-y: auto;
  border: 1rpx solid rgba(168, 132, 120, 0.24);
  border-radius: 8rpx;
  background: #fffaf4;
  box-shadow: 0 28rpx 70rpx rgba(49, 30, 26, 0.2);
  text-align: center;
  animation: letter-paper-appear 520ms ease both;
}

.letter-stage--opening .envelope-flap,
.letter-stage--open .envelope-flap {
  z-index: 1;
  transform: rotateX(180deg);
}

.letter-stage--opening .envelope-seal,
.letter-stage--open .envelope-seal {
  opacity: 0;
  transform: translateX(-50%) scale(0.72);
}

@keyframes letter-paper-appear {
  from {
    opacity: 0;
    transform: translateY(28rpx) scale(0.96);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.letter-title {
  display: block;
  color: #3e302d;
  font-family: "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 34rpx;
  font-weight: normal;
  line-height: 1.35;
}

.letter-body {
  display: block;
  margin-top: 34rpx;
  color: #6b5954;
  font-size: 28rpx;
  line-height: 1.78;
  text-align: left;
  white-space: pre-wrap;
}

.letter-image {
  display: block;
  width: 100%;
  margin-top: 28rpx;
  border-radius: 8rpx;
}

.letter-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  margin-top: 42rpx;
  border-radius: 8rpx;
  background: #6f4d45;
  color: #ffffff;
  font-size: 28rpx;
}

.letter-button--hover {
  opacity: 0.86;
}

@media (max-height: 700px) {
  .screen-inner {
    padding-top: 0;
    padding-bottom: calc(106rpx + env(safe-area-inset-bottom));
  }

  .section-title {
    margin-top: 10rpx;
    font-size: 36rpx;
  }

  .memory-carousel {
    margin-top: 26rpx;
  }

  .memory-card {
    justify-content: center;
  }

  .memory-image-frame {
    height: 48%;
    min-height: 0;
    max-height: 420rpx;
  }

  .memory-copy {
    margin: 0;
    padding: 20rpx 8rpx 2rpx;
  }

  .memory-title {
    font-size: 32rpx;
  }

  .memory-text {
    font-size: 24rpx;
    line-height: 1.62;
  }

  .detail-heading {
    margin-bottom: 34rpx;
  }

  .date-number {
    font-size: 88rpx;
  }

  .detail-row {
    padding: 18rpx 0;
  }

  .form-panel {
    margin-top: 36rpx;
  }

  .field-group {
    margin-bottom: 24rpx;
  }
}
