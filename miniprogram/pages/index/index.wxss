.memory-title {
  display: block;
  margin-top: 14rpx;
  color: #8c1f20;
  font-family: "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 36rpx;
  font-weight: normal;
  line-height: 1.28;
}

.memory-text {
  display: block;
  margin-top: 14rpx;
  color: #3e302d;
  font-family: "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 26rpx;
  line-height: 1.72;
}

.memory-progress {
  display: flex;
  justify-content: center;
  align-items: center;
