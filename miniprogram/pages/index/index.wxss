  height: 52rpx;
  margin-top: 14rpx;
}

.progress-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(121, 88, 79, 0.22);
  transition: width 180ms ease, background 180ms ease;
}

.progress-dot--active {
  width: 30rpx;
  background: #7d5a52;
}

@keyframes memory-title-enter {
  from {
    opacity: 0;
    transform: translateY(34rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes memory-carousel-enter {
  from {
    opacity: 0;
    transform: translateY(44rpx) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes memory-progress-enter {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.map-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  min-height: 92rpx;
  margin-top: 46rpx;
  border: 1rpx solid rgba(103, 71, 62, 0.22);
  border-radius: 8rpx;
  background: #6f4d45;
  color: #ffffff;
  font-family: "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 28rpx;
  font-weight: normal;
  transition: opacity 160ms ease, transform 160ms ease;
}

.map-button--hover {
  opacity: 0.86;
  transform: scale(0.99);
}

.detail-map-button {
  position: absolute;
  left: 50%;
  bottom: 106rpx;
  z-index: 2;
  min-width: 180rpx;
  min-height: 66rpx;
  margin-top: 0;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  transform: translateX(-50%);
}

.detail-map-button.map-button--hover {
  transform: translateX(-50%) scale(0.99);
}

.map-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
  box-sizing: border-box;
}

.map-icon-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #ffffff;
  transform: translate(-50%, -50%);
}

.guest-inner {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.guest-inner .section-top-space {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
}

.section-motion--active .guest-heading-motion {
  animation: guest-title-enter 2000ms cubic-bezier(0.2, 0.86, 0.24, 1) 500ms both;
}

.section-motion--active .guest-form-motion {
  animation: guest-form-enter 2480ms cubic-bezier(0.2, 0.86, 0.24, 1) 1200ms both;
}

@keyframes guest-title-enter {
  from {
    opacity: 0;
    transform: translateY(38rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes guest-form-enter {
  from {
    opacity: 0;
    transform: translateY(46rpx) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.form-panel {
  margin-top: 56rpx;
  padding: 8rpx 0 0;
}

.field-group {
  margin-bottom: 34rpx;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: #6c5751;
  font-size: 25rpx;
  line-height: 1.4;
  text-align: left;
}

.field-input,
.picker-display {
  width: 100%;
  min-height: 92rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(129, 96, 87, 0.2);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #3e302d;
  font-size: 30rpx;
  line-height: 92rpx;
  text-align: left;
}

.field-placeholder {
  color: #b5a29c;
}

.guest-picker {
  display: block;
}

.picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-display--placeholder {
  color: #b5a29c;
}

.picker-arrow {
  color: #a68a81;
  font-size: 32rpx;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 96rpx;
  margin-top: 66rpx;
  border-radius: 8rpx;
  background: #6f4d45;
  color: #ffffff;
  font-family: "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 30rpx;
  font-weight: normal;
  transition: opacity 160ms ease, transform 160ms ease;
}

.submit-button--hover {
  opacity: 0.86;
  transform: scale(0.99);
}

.submit-button[disabled] {
  opacity: 0.72;
  color: #ffffff;
  background: #6f4d45;
}

.guest-note {
  display: block;
  margin-top: 34rpx;
  color: #8a746d;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
}

.letter-mask {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100vh;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(53, 37, 34, 0.42);
}

.letter-scene {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 78vh;
  max-width: 650rpx;
}

.envelope-wrap {
  position: absolute;
  left: 50%;
  top: 60%;
  width: 600rpx;
  height: 390rpx;
  perspective: 1200rpx;
  transform: translate(-50%, -50%);
}

.envelope {
  position: absolute;
  left: 0;
  bottom: 0;
  z-index: 3;
  width: 100%;
  height: 360rpx;
}

.envelope-back {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 320rpx;
  border-radius: 8rpx;
  background: #ead5ca;
  box-shadow: 0 28rpx 70rpx rgba(49, 30, 26, 0.26);
}

.envelope-flap {
  position: absolute;
  left: 0;
  top: 40rpx;
  z-index: 5;
  width: 0;
  height: 0;
  border-left: 300rpx solid transparent;
  border-right: 300rpx solid transparent;
  border-top: 190rpx solid #d8aa99;
  transform-origin: center top;
  transition: transform 1200ms ease, z-index 1200ms ease;
}

.envelope-front {
  position: absolute;
  bottom: 0;
  width: 0;
  height: 0;
}

.envelope-front--left {
  left: 0;
  z-index: 4;
  border-bottom: 320rpx solid #e4c2b5;
  border-right: 315rpx solid transparent;
}

.envelope-front--right {
  right: 0;
  z-index: 4;
  border-bottom: 320rpx solid #e0baab;
  border-left: 315rpx solid transparent;
}

.envelope-front--bottom {
  left: 0;
  z-index: 6;
  border-left: 300rpx solid transparent;
  border-right: 300rpx solid transparent;
  border-bottom: 210rpx solid #c99180;
}

.envelope-seal {
  position: absolute;
  left: 50%;
  top: 166rpx;
  z-index: 7;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: #8c1f20;
  box-shadow: 0 8rpx 18rpx rgba(92, 30, 27, 0.25);
  transform: translateX(-50%);
  transition: opacity 500ms ease, transform 500ms ease;
}

.letter-paper {
  position: relative;
  z-index: 8;
  width: 510rpx;
  max-height: 62vh;
  padding: 46rpx 38rpx 38rpx;
  box-sizing: border-box;
  overflow-y: auto;
  border: 1rpx solid rgba(168, 132, 120, 0.24);
  border-radius: 8rpx;
  background: #fffaf4;
  box-shadow: 0 28rpx 70rpx rgba(49, 30, 26, 0.2);
  text-align: center;
  animation: letter-paper-appear 520ms ease both;
}

.letter-stage--opening .envelope-flap,
.letter-stage--open .envelope-flap {
  z-index: 1;
  transform: rotateX(180deg);
}

.letter-stage--opening .envelope-seal,
.letter-stage--open .envelope-seal {
  opacity: 0;
  transform: translateX(-50%) scale(0.72);
}

@keyframes letter-paper-appear {
  from {
    opacity: 0;
    transform: translateY(28rpx) scale(0.96);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.letter-title {
  display: block;
  color: #3e302d;
  font-family: "WeddingSerifSemiBold", "WeddingSerifRegular", "Source Han Serif SC", "STSong", "Songti SC", SimSun, serif;
  font-size: 34rpx;
  font-weight: normal;
  line-height: 1.35;
}

.letter-body {
  display: block;
  margin-top: 34rpx;
  color: #6b5954;
  font-size: 28rpx;
  line-height: 1.78;
  text-align: left;
  white-space: pre-wrap;
}

.letter-image {
  display: block;
  width: 100%;
  margin-top: 28rpx;
  border-radius: 8rpx;
}

.letter-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  margin-top: 42rpx;
  border-radius: 8rpx;
  background: #6f4d45;
  color: #ffffff;
  font-size: 28rpx;
}

.letter-button--hover {
  opacity: 0.86;
}

@media (max-height: 700px) {
  .screen-inner {
    padding-top: 0;
    padding-bottom: calc(106rpx + env(safe-area-inset-bottom));
  }

  .section-title {
    margin-top: 10rpx;
    font-size: 36rpx;
  }

  .memory-carousel {
    margin-top: 26rpx;
  }

  .memory-card {
    justify-content: center;
  }

  .memory-image-frame {
    height: 48%;
    min-height: 0;
    max-height: 420rpx;
  }

  .memory-copy {
    margin: 0;
    padding: 20rpx 8rpx 2rpx;
  }

  .memory-title {
    font-size: 32rpx;
  }

  .memory-text {
    font-size: 24rpx;
    line-height: 1.62;
  }

  .wedding-photo-inner {
    padding-top: calc(50rpx + env(safe-area-inset-top));
  }

  .wedding-photo-title-line--primary {
    font-size: 52rpx;
  }

  .wedding-photo-title-image {
    width: 280rpx;
  }

  .wedding-photo-title-line--secondary {
    margin-top: 6rpx;
    font-size: 34rpx;
  }

  .wedding-photo-carousel {
    height: 62vh;
    margin-top: 14rpx;
  }

  .form-panel {
    margin-top: 36rpx;
  }

  .field-group {
    margin-bottom: 24rpx;
  }
}
